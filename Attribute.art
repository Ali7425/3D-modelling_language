(* ============================================================ *)
(* Attribute-action interpreter for the 3D modelling language   *)
(* ============================================================ *)

//!interpreter attributeAction


(* ============================================================ *)
(* SUPPORT CODE / RUNTIME HELPERS                               *)
(* Stores variables, procedures, and helper functions for       *)
(* numeric, boolean, and arithmetic handling.                   *)
(* ============================================================ *)

!support
!! import java.util.Map; import java.util.HashMap; !!
!! Map<String, Object> variables = new HashMap<>();
   Map<String, AbstractAttributeBlock> procedures = new HashMap<>();
   Object currentSwitchValue = null;
   boolean switchMatched = false;

   double num(Object v) {
    if (v instanceof Integer) return ((Integer) v).doubleValue();
    if (v instanceof Double) return (Double) v;
    throw new RuntimeException ("Expected numeric value, got " + v);
   }

   boolean truth(Object v) {
    if (v instanceof Boolean) return (Boolean) v;
    if (v instanceof Integer) return ((Integer) v) != 0;
    if (v instanceof Double) return ((Double) v) != 0.0;
    throw new RuntimeException("Expected boolean-like value and got: " + v);
   }

   boolean same(Object a, Object b){
    if ((a instanceof Integer || a instanceof Double) && (b instanceof Integer || b instanceof Double))
      return num(a) == num(b);
    return a.equals(b);
   }

   Object addV (Object a, Object b) {
    if (a instanceof Double || b instanceof Double) return num(a) + num(b);
    return ((Integer) a) + ((Integer) b);
   }

   Object subV(Object a, Object b) {
    if (a instanceof Double || b instanceof Double) return num(a) - num(b);
    return ((Integer) a) - ((Integer) b);
   }

   Object mulV(Object a, Object b) {
     if (a instanceof Double || b instanceof Double) return num(a) * num(b);
     return ((Integer) a) * ((Integer) b);
   }

   Object divV(Object a, Object b) {
     if (a instanceof Double || b instanceof Double) return num(a) / num(b);
     return ((Integer) a) / ((Integer) b);
   }

   Object negV(Object a) {
     if (a instanceof Double) return -((Double) a);
     return -((Integer) a);
   }
!!
 

(* ============================================================ *)
(* TOP-LEVEL PROGRAM / STATEMENT SEQUENCES                      *)
(* ============================================================ *)

statements ::= statement statements
| statement !! System.out.println("Final variable map " + variables); !!


(* ============================================================ *)
(* STATEMENT RULES                                              *)
(* Includes assignment, blocks, control flow, procedures,       *)
(* modelling commands, grouping, switch, and raw plugin calls.  *)
(* ============================================================ *)

statement ::=
  ID ':=' e0 ';' !! variables.put(ID1.v, e01.v); !!     // assignment

| '{' statements!< '}' !! interpret(statements1); !!    // block statement

| 'if' e0 'then' statement!< 'else' statement!<         // if statement
  !! if (truth(e01.v)) interpret(statement1); else interpret(statement2); !!

| 'while' e0!< 'do' statement!<                         // while statement
  !! interpret(e01); while (truth(e01.v)) { interpret(statement1); interpret(e01); } !!

| ID '++' ';' !! variables.put(ID1.v, addV(variables.get(ID1.v), 1)); !!   // increment
| ID '--' ';' !! variables.put(ID1.v, subV(variables.get(ID1.v), 1)); !!   // decrement

| 'box' e0 ',' e0 ',' e0 ';' !! plugin ("box", num(e01.v), num(e02.v), num(e03.v)); !!          // box
| 'sphere' e0 ';' !! plugin ("sphere", num(e01.v)); !!                                            // sphere
| 'cylinder' e0 ',' e0 ';' !! plugin ("cylinder", num(e01.v), num(e02.v)); !!                    // cylinder
| 'translate' e0 ',' e0 ',' e0 ';' !! plugin("translate", num(e01.v), num(e02.v), num(e03.v)); !! // translate
| 'rotate' e0 ',' e0 ',' e0 ';' !! plugin("rotate", num(e01.v), num(e02.v), num(e03.v)); !!       // rotate
| 'scale' e0 ',' e0 ',' e0 ';' !! plugin("scale", num(e01.v), num(e02.v), num(e03.v)); !!         // scale

| GROUP_KW '{' statements!< '}'                        // grouping statement
  !! plugin("groupStart");
     interpret(statements1);
     plugin("groupEnd"); !!

| SWITCH_KW e0 '{' switchCases!< '}'                   // switch statement
  !! currentSwitchValue = e01.v;
     switchMatched = false;
     interpret(switchCases1); !!

| 'plugin' '(' STRING_SQ ')' ';' !! plugin(STRING_SQ1.v); !!                                      // raw plugin call
| 'plugin' '(' STRING_SQ ',' e0 ')' ';' !! plugin(STRING_SQ1.v, e01.v); !!                        // raw plugin call, 1 arg
| 'plugin' '(' STRING_SQ ',' e0 ',' e0 ')' ';' !! plugin(STRING_SQ1.v, e01.v, e02.v); !!         // raw plugin call, 2 args
| 'plugin' '(' STRING_SQ ',' e0 ',' e0 ',' e0 ')' ';' !! plugin(STRING_SQ1.v, e01.v, e02.v, e03.v); !! // raw plugin call, 3 args

| PROCEDURE ID statement!<                           // procedure definition
    !! procedures.put(ID1.v, statement1); !!

| CALL_KW ID ';'                                     // procedure call
    !! interpret(procedures.get(ID1.v)); !!


(* ============================================================ *)
(* SWITCH HELPER RULES                                          *)
(* switchCases holds the list of cases. switchCase checks       *)
(* whether the current switch expression matches.               *)
(* ============================================================ *)

switchCases ::= switchCase!<
  !! interpret(switchCase1); !!
| switchCase!< switchCases!<
  !! interpret(switchCase1); interpret(switchCases1); !!

switchCase ::= CASE_KW e0 ':' statement!<
  !! if (!switchMatched && same(currentSwitchValue, e01.v)){
      switchMatched = true;
      interpret(statement1);
    } !!


(* ============================================================ *)
(* EXPRESSION GRAMMAR                                           *)
(* e0 = comparisons                                             *)
(* e1 = + and -                                                 *)
(* e2 = * and /                                                 *)
(* e3 = literals, variables, unary minus, parentheses, plugin   *)
(* ============================================================ *)

e0 <v::Object> ::=  e1 !! e0.v = e11.v; !!
  | e1 '>' e1 !! e0.v = num(e11.v) > num(e12.v); !!
  | e1 '<' e1 !! e0.v = num(e11.v) < num(e12.v); !!
  | e1 '==' e1 !! e0.v = same(e11.v, e12.v); !!
  | e1 '!=' e1 !! e0.v = !same(e11.v, e12.v); !!

e1 <v::Object> ::= e2 !! e1.v = e21.v; !!
  | e1 '+' e2 !! e1.v = addV(e11.v, e21.v); !!
  | e1 '-' e2 !! e1.v = subV(e11.v, e21.v); !!

e2 <v::Object> ::= e3 !! e2.v = e31.v; !!
  | e2 '*' e3 !! e2.v = mulV(e21.v, e31.v); !!
  | e2 '/' e3 !! e2.v = divV(e21.v, e31.v); !!

e3 <v::Object> ::= REAL !! e3.v = REAL1.v; !!
  | INTEGER !! e3.v = INTEGER1.v; !!
  | 'true'  !! e3.v = true; !!
  | 'false' !! e3.v = false; !!
  | ID      !! e3.v = variables.get(ID1.v); !!
  | '-' e3  !! e3.v = negV(e31.v); !!
  | '(' e0 ')' !! e3.v = e01.v; !!
  | STRING_SQ !! e3.v = STRING_SQ1.v; !!
  | 'plugin' '(' STRING_SQ ',' e0 ')' !! e3.v = plugin(STRING_SQ1.v, e01.v); !!


(* ============================================================ *)
(* KEYWORD / LEXICAL RULES                                      *)
(* ============================================================ *)

PROCEDURE ::= 'procedure'
CALL_KW  ::= 'call'
GROUP_KW ::= 'group'
SWITCH_KW ::= 'switch'
CASE_KW ::= 'case'

ID <v::String>        ::= &ID !! ID.v = lexeme(); !!
STRING_SQ <v::String> ::= &STRING_SQ !! STRING_SQ.v = lexeme().translateEscapes(); !!
INTEGER  <v::Integer> ::= &INTEGER !! INTEGER.v = Integer.parseInt(lexeme()); !!
REAL <v::Double>      ::= &REAL !! REAL.v = Double.parseDouble(lexeme()); !!


(* ============================================================ *)
(* TESTS                                                        *)
(* Each test section checks a different language feature.       *)
(* ============================================================ *)


(* ------------------------------------------------------------ *)
(* TEST 1: If and While Loops                                   *)
(* ------------------------------------------------------------ *)
!try "if true then x := 1; else x := 2;"
!try "x := 3; while x > 0 do { x := x - 1; }"


(* ------------------------------------------------------------ *)
(* TEST 2: Procedures                                           *)
(* ------------------------------------------------------------ *)
!try "procedure p { x := 99; } call p;"
!try "procedure p { x := x + 1; } x := 5; call p;"


(* ------------------------------------------------------------ *)
(* TEST 3: Increment / Decrement                                *)
(* ------------------------------------------------------------ *)
!try "x := 5; x++;"
!try "x := 5; x--;"
!try "x := 2.5; x++;"
!try "x := 2.5; x--;"


