(* ------------------------------------------------------------ *)
(* TEST 6: Switch Statements                                    *)
(* ------------------------------------------------------------ *)
!try "x := 2; switch x { case 1: y := 10; case 2: y := 20; }"
!try "x := 1; switch x { case 1: y := 99; case 2: y := 20; }"
!try "x := 3; switch x { case 1: y := 10; case 2: y := 20; }"


(* ------------------------------------------------------------ *)
(* TEST 7: Project Demo                                         *)
(* ------------------------------------------------------------ *)
!try "plugin('init');
size := 20.0;
height := 40.0;
choice := 2;

procedure buildShape {
  switch choice {
    case 1: box size, size, size;
    case 2: cylinder 10.0, height;
  }
}

group {
  call buildShape;
  sphere 10.0;
  translate 0.0, size + 10.0, 0.0;
}"